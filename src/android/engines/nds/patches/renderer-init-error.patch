diff --git a/src/android/MelonInstance.cpp b/src/android/MelonInstance.cpp
--- a/src/android/MelonInstance.cpp
+++ b/src/android/MelonInstance.cpp
@@ -17,6 +17,7 @@
 #include "NDSCart.h"
 #include "net/Net_Slirp.h"
 #include "Platform.h"
 #include "SDCardArgsBuilder.h"
+#include <stdexcept>
 
 using namespace std;
@@ -626,8 +627,23 @@
             case Renderer::OpenGl:
-                nds->GPU.SetRenderer3D(GLRenderer::New());
+            {
+                GLint major = 0, minor = 0;
+                glGetIntegerv(GL_MAJOR_VERSION, &major);
+                glGetIntegerv(GL_MINOR_VERSION, &minor);
+                if (major < 3 || (major == 3 && minor < 2))
+                    throw std::runtime_error("DS OpenGL renderer requires OpenGL ES 3.2; select Software in DS settings");
+                auto renderer = GLRenderer::New();
+                if (!renderer)
+                    throw std::runtime_error("DS OpenGL shader initialization failed; select Software in DS settings");
+                nds->GPU.SetRenderer3D(std::move(renderer));
                 break;
+            }
             case Renderer::Compute:
-                nds->GPU.SetRenderer3D(ComputeRenderer::New());
+            {
+                auto renderer = ComputeRenderer::New();
+                if (!renderer)
+                    throw std::runtime_error("DS compute shader initialization failed");
+                nds->GPU.SetRenderer3D(std::move(renderer));
                 break;
+            }
             default: __builtin_unreachable();
         }
