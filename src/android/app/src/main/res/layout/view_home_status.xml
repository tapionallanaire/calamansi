<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:background="@color/home_silver">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/home_menu" android:textColor="@color/home_secondary_ink" android:textSize="12sp" />
    <TextClock android:id="@+id/home_status_clock" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:gravity="end" android:paddingStart="12dp"
        android:format12Hour="M/d (EEE) h:mm" android:format24Hour="M/d (EEE) HH:mm"
        android:textColor="@color/home_ink" android:textSize="12sp" />
    <ImageView android:id="@+id/home_status_battery" android:layout_width="28dp" android:layout_height="12dp"
        android:layout_marginStart="10dp" android:src="@drawable/home_battery" android:visibility="invisible" />
</LinearLayout>
