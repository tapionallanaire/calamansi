<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true" android:focusable="false"
    android:descendantFocusability="blocksDescendants" android:background="@drawable/home_wallpaper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp"
        android:minHeight="200dp">
        <FrameLayout android:layout_width="128dp" android:layout_height="128dp"
            android:background="@drawable/home_cartridge_surface" android:elevation="3dp" android:padding="16dp">
            <ImageView android:id="@+id/home_preview_icon" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <com.google.android.material.textview.MaterialTextView android:id="@+id/home_preview_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center" android:maxLines="3"
            android:textAppearance="?attr/textAppearanceTitleLarge" android:text="@string/home_select_game" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/home_preview_metadata"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
